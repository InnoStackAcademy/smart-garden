# ── MongoDB ──────────────────────────────────────
MONGO_URI=mongodb://mongo:27017/smart-garden

# ── MQTT Broker ──────────────────────────────────
MQTT_BROKER_URL=mqtt://mosquitto:1883
MQTT_CLIENT_ID=smart-garden-backend

# ── Server ───────────────────────────────────────
PORT=3000
NODE_ENV=development
