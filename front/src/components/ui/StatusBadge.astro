---
interface Props {
	status: 'connected' | 'disconnected' | 'warning';
	label: string;
}

const { status, label } = Astro.props;

const statusColors = {
	connected: 'bg-primary/10 text-primary',
	disconnected: 'bg-error/10 text-error',
	warning: 'bg-tertiary/10 text-tertiary',
};

const dotColors = {
	connected: 'bg-primary',
	disconnected: 'bg-error',
	warning: 'bg-tertiary',
};
---

<div class={`${statusColors[status]} px-4 py-2 rounded-full flex items-center gap-2 border border-current/10`}>
	<span class="relative flex h-3 w-3">
		{status === 'connected' && (
			<span class={`animate-ping absolute inline-flex h-full w-full rounded-full ${dotColors[status]} opacity-75`}></span>
		)}
		<span class={`relative inline-flex rounded-full h-3 w-3 ${dotColors[status]}`}></span>
	</span>
	<span class="text-[10px] font-black uppercase tracking-widest">{label}</span>
</div>
