---
import MainLayout from "../layouts/MainLayout.astro";
import NotificationItem from "../components/ui/NotificationItem.tsx";
---

<MainLayout title="Alertas del Sistema">
	<header class="mb-12 flex justify-between items-end">
		<div>
			<span class="text-secondary font-body text-[10px] uppercase tracking-[0.2em] font-bold block mb-2">Logs de Seguridad</span>
			<h2 class="text-4xl font-headline font-black text-on-surface tracking-tight">Alertas del Sistema</h2>
		</div>
		<div class="flex items-center gap-4">
			<button class="bg-surface-container px-6 py-2 rounded-xl text-[10px] font-bold uppercase tracking-widest text-secondary hover:text-primary transition-all">Limpiar Todo</button>
		</div>
	</header>

	<div class="flex flex-col gap-4 max-w-4xl">
		<NotificationItem 
			client:load
			type="critical" 
			title="Fallo de Bomba Detectado" 
			message="La bomba principal en la Zona 1 reportó falta de flujo mientras estaba activa. Posible bloqueo o funcionamiento en seco." 
			time="hace 10 min" 
		/>
		<NotificationItem 
			client:load
			type="warning" 
			title="Advertencia: Alta Temperatura" 
			message="La temperatura alcanzó los 32°C. El sistema de ventilación está al 100% de capacidad." 
			time="hace 1 hora" 
		/>
		<NotificationItem 
			client:load
			type="info" 
			title="Actualización del Sistema" 
			message="BioSync OS actualizado a v2.4.1. Mejoras en la precisión de los sensores." 
			time="hace 4 horas" 
		/>
		<NotificationItem 
			client:load
			type="info" 
			title="Riego Programado" 
			message="Ciclo de riego automático completado con éxito para la Zona 3." 
			time="Ayer, 08:00 PM" 
		/>
		<NotificationItem 
			client:load
			type="critical" 
			title="Batería Crítica" 
			message="El ESP32 de respaldo en el Jardín Terraza está al 5%. Por favor, cambie las baterías o conecte a fuente DC." 
			time="Ayer, 02:30 PM" 
		/>
	</div>
</MainLayout>
