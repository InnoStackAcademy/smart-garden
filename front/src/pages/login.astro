---
import AuthLayout from "../layouts/AuthLayout.astro";
---

<AuthLayout title="Login">
	<div class="w-full max-w-md bg-white/40 backdrop-blur-3xl p-12 rounded-[3.5rem] shadow-[0_30px_100px_rgba(0,105,72,0.1)] border border-white/50 relative z-10">
		<div class="text-center mb-10">
			<h1 class="text-4xl font-headline font-black text-primary tracking-tighter mb-2">BioSync</h1>
			<p class="text-xs font-bold text-secondary uppercase tracking-[0.3em]">Digital Greenhouse Access</p>
		</div>

		<form class="space-y-6">
			<div>
				<label class="text-[10px] uppercase font-black text-secondary/60 ml-4 mb-2 block tracking-widest">Operator ID</label>
				<input type="email" placeholder="operator@biosync.io" class="w-full bg-white/50 border-none rounded-[2rem] py-4 px-6 text-sm font-medium focus:ring-4 focus:ring-primary/10 transition-all outline-none" />
			</div>
			<div>
				<label class="text-[10px] uppercase font-black text-secondary/60 ml-4 mb-2 block tracking-widest">Access Key</label>
				<input type="password" placeholder="••••••••" class="w-full bg-white/50 border-none rounded-[2rem] py-4 px-6 text-sm font-medium focus:ring-4 focus:ring-primary/10 transition-all outline-none" />
			</div>

			<div class="pt-4">
				<a href="/" class="w-full bg-primary text-white py-4 rounded-[2rem] font-bold shadow-2xl shadow-primary/30 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-2">
					Initialize Session
				</a>
			</div>
		</form>

		<div class="mt-10 text-center">
			<p class="text-xs text-secondary font-medium">Secured by BioSync InnoStack Protocol</p>
		</div>
	</div>
</AuthLayout>
