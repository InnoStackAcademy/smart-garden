---
import MainLayout from "../layouts/MainLayout.astro";
import SensorCard from "../components/ui/SensorCard.tsx";
---

<MainLayout title="Growth Trends">
	<header class="mb-12 flex justify-between items-end">
		<div>
			<span class="text-secondary font-body text-[10px] uppercase tracking-[0.2em] font-bold block mb-2">Análisis de Datos</span>
			<h2 class="text-4xl font-headline font-black text-on-surface tracking-tight">Tendencias de Crecimiento</h2>
		</div>
		<div class="flex gap-4">
			<select class="bg-surface-container border-none rounded-xl px-4 py-2 text-sm font-bold text-secondary outline-none focus:ring-2 focus:ring-primary/20">
				<option>Last 24 Hours</option>
				<option>Last 7 Days</option>
				<option>Last Month</option>
			</select>
			<button class="bg-primary text-white p-2 rounded-xl shadow-lg shadow-primary/20">
				<span class="material-symbols-outlined">download</span>
			</button>
		</div>
	</header>

	<!-- Historical Summary -->
	<div class="grid grid-cols-4 gap-6 mb-12">
		<SensorCard client:load label="Max Temp" value={28.2} unit="°C" icon="device_thermostat" color="tertiary" />
		<SensorCard client:load label="Min Temp" value={19.5} unit="°C" icon="ac_unit" color="secondary" />
		<SensorCard client:load label="Avg Humidity" value={65} unit="%" icon="water_drop" color="primary" />
		<SensorCard client:load label="Total UV" value={420} unit="nm" icon="sunny" color="error" />
	</div>

	<!-- Main Charts -->
	<div class="space-y-8">
		<div class="bg-surface-container-lowest p-10 rounded-[3rem] shadow-sm border border-white/50">
			<h3 class="text-xl font-bold mb-8">Soil Moisture Saturation</h3>
			<div class="h-96 bg-surface-container/20 rounded-[2rem] border-2 border-dashed border-secondary/10 flex items-center justify-center text-secondary/40 italic">
				High-fidelity line chart will render here (Chart.js / Recharts)
			</div>
		</div>

		<div class="bg-surface-container-lowest p-10 rounded-[3rem] shadow-sm border border-white/50">
			<h3 class="text-xl font-bold mb-8">Light Cycle Efficiency</h3>
			<div class="h-96 bg-surface-container/20 rounded-[2rem] border-2 border-dashed border-secondary/10 flex items-center justify-center text-secondary/40 italic">
				Bar chart representation of light exposure per zone
			</div>
		</div>
	</div>
</MainLayout>
