---
import "../styles/global.css";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="BioSync - Smart Garden IoT" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | BioSync</title>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@600;700;800;900&display=swap" rel="stylesheet" />
		<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
	</head>
	<body class="bg-background text-on-surface">
		<div class="flex">
			<!-- SideNavBar (Simulado por ahora como componente estático en el layout) -->
			<aside class="h-screen w-72 flex flex-col fixed left-0 top-0 bg-surface-container shadow-[0_0_40px_0_rgba(25,28,30,0.06)] z-50">
				<div class="flex flex-col gap-4 p-6 h-full">
					<div class="mb-8">
						<span class="font-headline font-extrabold text-2xl text-primary">BioSync</span>
						<p class="font-headline text-[10px] uppercase tracking-widest font-bold text-secondary mt-1">Digital Greenhouse</p>
					</div>
					<nav class="flex flex-col gap-2 flex-grow">
						<a class="text-secondary hover:text-primary px-4 py-3 hover:bg-background transition-all rounded-xl flex items-center gap-3" href="/">
							<span class="material-symbols-outlined">potted_plant</span>
							<span class="font-headline text-[10px] uppercase tracking-widest font-bold">Garden Stats</span>
						</a>
						<a class="text-secondary hover:text-primary px-4 py-3 hover:bg-background transition-all rounded-xl flex items-center gap-3" href="/control/">
							<span class="material-symbols-outlined">tune</span>
							<span class="font-headline text-[10px] uppercase tracking-widest font-bold">Manual Control</span>
						</a>
						<a class="text-secondary hover:text-primary px-4 py-3 hover:bg-background transition-all rounded-xl flex items-center gap-3" href="/historico/">
							<span class="material-symbols-outlined">monitoring</span>
							<span class="font-headline text-[10px] uppercase tracking-widest font-bold">Growth Trends</span>
						</a>
						<a class="text-secondary hover:text-primary px-4 py-3 hover:bg-background transition-all rounded-xl flex items-center gap-3" href="/alertas/">
							<span class="material-symbols-outlined">notifications_active</span>
							<span class="font-headline text-[10px] uppercase tracking-widest font-bold">System Alerts</span>
						</a>
						<a class="text-secondary hover:text-primary px-4 py-3 hover:bg-background transition-all rounded-xl flex items-center gap-3" href="/configuracion/">
							<span class="material-symbols-outlined">settings</span>
							<span class="font-headline text-[10px] uppercase tracking-widest font-bold">System Config</span>
						</a>
					</nav>
					<div class="mt-auto pt-6 border-t border-slate-200">
						<button class="w-full bg-primary text-white py-3 rounded-xl font-bold font-headline shadow-lg transition-transform active:scale-95">
							Logout
						</button>
					</div>
				</div>
			</aside>

			<main class="ml-72 flex-grow p-8 min-h-screen">
				<slot />
			</main>
		</div>
	</body>
</html>
